# =============================================================================
# ChickenKiller - Unity 6.3 / Windows x64
# Docs is intentionally local-only for this project.
# Never ignore .meta files: Unity asset identity depends on them.
# =============================================================================

# Local documentation (task book, ADRs, agent notes)
/Docs/

# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Verification artifacts: keep screenshots/logs locally, do not commit them
/TestArtifacts/*
!/TestArtifacts/README.md
!/TestArtifacts/.gitkeep

# Unity crash / local diagnostics
sysinfo.txt
crashlytics-build.properties
*.stackdump
*.dmp
*.mdmp
*.log

# IDE / generated project files
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Native build output
/Native/build*/
/Native/out/
/Native/**/CMakeFiles/
/Native/**/CMakeCache.txt
/Native/**/cmake_install.cmake
/Native/**/Makefile
/Native/**/*.ninja
/Native/**/.ninja_deps
/Native/**/.ninja_log
/Native/CMakeUserPresets.json

# Native plugins are built from source; keep the directory, not the binaries
/Assets/Plugins/Windows/x86_64/*.dll
/Assets/Plugins/Windows/x86_64/*.pdb
!/Assets/Plugins/Windows/x86_64/.gitkeep

# StreamingAssets copy is generated by BuildScript from Config/CombatPrototype.json
/Assets/StreamingAssets/Config/CombatPrototype.json

# Generated data (phase 1 uses Config/CombatPrototype.json as the source of truth)
/Config/Generated/
/Config/Cooked/
*.ckb

# Build artifacts
*.apk
*.aab
*.unitypackage
*.exe
*.zip

# OS / editor temp files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

